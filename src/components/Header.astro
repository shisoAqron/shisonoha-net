---
import { nav, site } from '../data/site';
---

<header class="site-header">
  <div class="container">
    <a class="logo" href="/">{site.name}</a>
    <nav class="main-nav" aria-label="メインメニュー">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
